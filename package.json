{
  "name": "dsh-zcode-rewind",
  "version": "1.0.0",
  "description": "Per-tool-call workspace checkpoints for DeepSeek Harness: captures every file mutation including shell side effects, stores content-addressed blobs, previews line-level diffs, and every restore is itself undoable.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "guards": "node test/run.mjs && node tools/verify-translation-pairing.mjs && node tools/verify-doc-numbers.mjs && node tools/verify-version-consistency.mjs",
    "prepublishOnly": "node test/run.mjs && node tools/verify-translation-pairing.mjs && node tools/verify-doc-numbers.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.5-alpha.1 <0.2.0-0 || >=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.1 <0.2.0-0"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-alpha.1 <0.2.0-0 || >=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-alpha.1 <0.2.0-0 || >=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.1 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {},
  "files": [
    "lib",
    "test",
    "tools",
    "docs",
    "cordis.patch.yml",
    "install.sh",
    "uninstall.sh",
    "AGENTS.md",
    "*.md",
    "*.i18n.yaml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BOWLUNA/dsh-zcode-rewind.git"
  },
  "homepage": "https://github.com/BOWLUNA/dsh-zcode-rewind",
  "bugs": {
    "url": "https://github.com/BOWLUNA/dsh-zcode-rewind/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "checkpoint",
    "rewind",
    "undo",
    "rollback",
    "snapshot",
    "workspace",
    "zcode"
  ]
}
